# 多用户模式（商业版）的后端配置，由 docker-compose.multi-user.yml 加载。
# 每一项的说明见 README.md 的「多用户模式」一节。

# 开启多用户：网站账号用户名 + 密码登录，数据按账号隔离，任务统一用平台的模型和 OCR、按页扣额度。
RETAIN_DEPLOYMENT_MODE=multi

# 第一个管理员。只在库里一个可用管理员都没有时才会用它建号。密码至少 8 位；
# 只填用户名、密码留空时 app 会拒绝启动（防止带着空密码上线）。
# 建好之后请登录改密码，再把这两行**都**删掉并重启 app（只清空密码同样会启动失败），
# 别让明文密码一直留在这个文件里。
RETAIN_BOOTSTRAP_ADMIN_USERNAME=admin
RETAIN_BOOTSTRAP_ADMIN_PASSWORD=

# 用户在浏览器里访问的完整地址（协议 + 域名 + 端口，不带路径），多个用逗号分隔。
# 同源部署（页面和 API 都走同一个域名）时后端也会放行，但带端口的地址、或宿主机 NGINX
# 用 $host 转发（会丢掉端口）时只有写在这里才放行，所以建议总是填上。
RETAIN_ALLOWED_ORIGINS=https://pdf.example.com

# 登录 Cookie 只走 HTTPS。正式部署保持 1；只有在本机用 http 试用时才改成 0。
RETAIN_SESSION_COOKIE_SECURE=1

# 登录有效天数（1～365）。
RETAIN_SESSION_TTL_DAYS=30

# 平台的翻译模型和 OCR：推荐上线后在管理后台「平台设置」页填写（保存即生效，密钥存进
# 凭据库）。这里留空即可；在管理后台保存过之后，下面这些环境变量就不再生效。
# RETAIN_PLATFORM_TRANSLATION_MODEL=
# RETAIN_PLATFORM_TRANSLATION_BASE_URL=
# RETAIN_PLATFORM_TRANSLATION_API_PROTOCOL=
# RETAIN_PLATFORM_TRANSLATION_THINKING=
# RETAIN_PLATFORM_TRANSLATION_MAX_WORKERS=
# RETAIN_PLATFORM_TRANSLATION_CREDENTIAL_REF=
# RETAIN_PLATFORM_OCR_PROVIDER=
# RETAIN_PLATFORM_OCR_CREDENTIAL_REF=
