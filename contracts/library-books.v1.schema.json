{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "retainpdf/contracts/library-books/v1",
  "title": "任务列表与删任务契约（Library Books，文件名沿用书架时期）",
  "description": "删一个任务的返回（DELETE /api/v1/jobs/:job_id）。任务列表 GET /api/v1/jobs 只登记在 job-status.v1（2026-10-23 删了这里重复的一条）；下面 JobListView、JobListItemView、JobFailureBriefView、JobProgressView 等任务列表定义还留着，是前端 frontend/web/tests/contracts 两个测试直接读这份 JSON，等它们改读 job-status.v1 再删，生成的 library-books.ts 已经不导出它们，两边由 contracts/tests/job-definitions-parity.test.mjs 锁成一致。名字和 $id 沿用书架时期：书架 /api/v1/library/books（列表、删除旧地址）2026-10-22 删了，它的 LibraryBookListView / LibraryBookDetailView 等定义一起删了。生产者：backend/packages/retainpdf-jobs/src/views/job_types.rs（JobListView / JobListItemView / JobFailureBriefView）、views/common.rs（JobDeleteResultView，本契约里叫 LibraryDeleteResultView；DeleteJobQuery，本契约里叫 LibraryDeleteQuery）；消费者：@retainpdf/contracts/library-books 生成 DTO（@retainpdf/api 的 deleteJob 用 LibraryDeleteResultView）、packages/domain 的 job 归一化模型、frontend/web 的契约测试。所有响应为 {code, message, data} 信封，本契约描述 data 部分。改契约先改本文件，再重新生成 DTO 并让 Rust 与 TS 契约测试变绿。",
  "base_path": "/api/v1/jobs",
  "endpoints": [
    {
      "method": "DELETE",
      "path": "/api/v1/jobs/:job_id",
      "client_name": "deleteJob",
      "transport": "json",
      "query": "LibraryDeleteQuery",
      "output": "LibraryDeleteResultView",
      "rust_view": "JobDeleteResultView",
      "note": "删一个任务和它的 -ocr 子任务，书留着；OCR 任务也能删。查询参数在 Rust 里是 DeleteJobQuery，和 LibraryDeleteQuery 同形。书架删除的旧地址 DELETE /api/v1/library/books/:job_id 2026-10-22 删了。"
    }
  ],
  "definitions": {
    "JobStatusKind": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "canceled"
      ],
      "description": "crate::models::common::JobStatusKind (serde rename_all snake_case)"
    },
    "WorkflowKind": {
      "type": "string",
      "enum": [
        "book",
        "ocr",
        "translate",
        "render"
      ],
      "description": "crate::models::common::WorkflowKind"
    },
    "JobProgressView": {
      "type": "object",
      "description": "backend/packages/retainpdf-jobs/src/views/common.rs :: JobProgressView。current/total 为页/批计数（i64），percent 0-100，unit 标识页/批/步/percent。",
      "required": [],
      "properties": {
        "current": {
          "type": [
            "integer",
            "null"
          ],
          "description": "已完成计数，null=未知"
        },
        "total": {
          "type": [
            "integer",
            "null"
          ],
          "description": "总数，null=未定/不定长"
        },
        "percent": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "description": "page|batch|step|percent|null，skip_serializing_if None"
        }
      }
    },
    "JobFailureBriefView": {
      "type": "object",
      "description": "backend/packages/retainpdf-jobs/src/views/job_types.rs :: JobFailureBriefView — 列表里那份精简失败信息。只有失败的任务才带（JobListItemView.failure），成功 / 进行中的任务整个键不出现，不是 null。只放「一眼能判断该怎么办」的几项，不带 raw_excerpt / traceback；要完整错误按需去打任务详情（那边的 failure 是 JobFailureInfo）。root_cause / suggestion / provider 为空时整个键不出现（不是 null）。",
      "required": [
        "category",
        "stage",
        "retryable",
        "summary"
      ],
      "properties": {
        "category": {
          "type": "string",
          "description": "面向用户的分类：provider / translation / timeout / render / internal …"
        },
        "stage": {
          "type": "string",
          "description": "失败发生在哪一段：ocr / translation / render"
        },
        "retryable": {
          "type": "boolean",
          "description": "能不能重试。"
        },
        "summary": {
          "type": "string",
          "description": "一句话结论。"
        },
        "root_cause": {
          "type": "string",
          "description": "根因；没有时键不出现。"
        },
        "suggestion": {
          "type": "string",
          "description": "建议的处理办法；没有时键不出现。"
        },
        "provider": {
          "type": "string",
          "description": "上游是谁（mineru / deepseek …），排查时第一眼要看的；没有时键不出现。"
        }
      }
    },
    "JobListItemView": {
      "type": "object",
      "description": "job_types.rs :: JobListItemView — /api/v1/jobs 列表项，含 stage_snapshot 与 cover/thumbnail 双图。",
      "required": [
        "job_id",
        "display_name",
        "workflow",
        "status",
        "attempt",
        "retry_count",
        "last_retry_at",
        "stage_snapshot",
        "background_snapshots",
        "stages",
        "output_pdf_ready",
        "markdown_ready",
        "bundle_ready",
        "created_at",
        "updated_at",
        "detail_path",
        "detail_url"
      ],
      "properties": {
        "job_id": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "workflow": {
          "$ref": "#/definitions/WorkflowKind"
        },
        "status": {
          "$ref": "#/definitions/JobStatusKind"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "retry_count": {
          "type": "integer",
          "minimum": 0
        },
        "last_retry_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "trace_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "completion_note": {
          "type": [
            "string",
            "null"
          ],
          "description": "终态任务的完成说明，仅在有额外信息时出现（正常完成为 null）。例如「任务完成，但有 N 个内容块保留原文未翻译」。这不是阶段字段——终态的 stage_snapshot 恒为 null。"
        },
        "stage_snapshot": {
          "anyOf": [
            {
              "$ref": "#/definitions/JobStageSnapshotView"
            },
            {
              "type": "null"
            }
          ]
        },
        "background_snapshots": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/JobStageSnapshotView"
          }
        },
        "stages": {
          "$ref": "#/definitions/JobStagesView"
        },
        "page_count": {
          "type": [
            "integer",
            "null"
          ]
        },
        "source_file_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "cover_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "thumbnail_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "output_pdf_ready": {
          "type": "boolean"
        },
        "markdown_ready": {
          "type": "boolean"
        },
        "bundle_ready": {
          "type": "boolean"
        },
        "invocation": {
          "anyOf": [
            {
              "$ref": "#/definitions/InvocationSummaryView"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "detail_path": {
          "type": "string"
        },
        "detail_url": {
          "type": "string"
        },
        "source_artifact_job_id": {
          "type": ["string", "null"],
          "description": "复用了哪个任务的产物（OCR / 译文）；顺着它能找到真正持有译文的任务。没有复用时为 null。"
        },
        "failure": {
          "$ref": "#/definitions/JobFailureBriefView"
        }
      }
    },
    "JobListView": {
      "type": "object",
      "required": [
        "items",
        "invocation_summary",
        "limit",
        "offset",
        "has_more"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/JobListItemView"
          }
        },
        "invocation_summary": {
          "$ref": "#/definitions/JobListInvocationSummaryView"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "description": "实际生效的条数上限。越界（0 或大于 500）是 400，不会被夹，所以总等于请求的值；没传是 20。"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "has_more": {
          "type": "boolean",
          "description": "这一页之后还有没有。"
        }
      }
    },
    "JobStageSnapshotView": {
      "type": "object",
      "description": "job_types.rs :: JobStageSnapshotView — 阶段快照（含 display_stage / stage / substage / lane / stage_detail / progress）。前端 normalize 与阶段进度均以此驱动。",
      "required": [
        "progress"
      ],
      "properties": {
        "display_stage": {
          "type": [
            "string",
            "null"
          ]
        },
        "stage": {
          "type": [
            "string",
            "null"
          ]
        },
        "substage": {
          "type": [
            "string",
            "null"
          ]
        },
        "lane": {
          "type": [
            "string",
            "null"
          ],
          "description": "main|background"
        },
        "stage_detail": {
          "type": [
            "string",
            "null"
          ]
        },
        "progress": {
          "$ref": "#/definitions/JobProgressView"
        }
      }
    },
    "JobStageStateView": {
      "type": "string",
      "enum": [
        "reused",
        "queued",
        "pending",
        "in_progress",
        "completed",
        "failed",
        "skipped"
      ]
    },
    "JobStageRuntimeView": {
      "type": "object",
      "required": [
        "state",
        "progress"
      ],
      "properties": {
        "state": {
          "$ref": "#/definitions/JobStageStateView"
        },
        "progress": {
          "$ref": "#/definitions/JobProgressView"
        }
      }
    },
    "JobStagesView": {
      "type": "object",
      "required": [
        "ocr",
        "translation",
        "render"
      ],
      "properties": {
        "ocr": {
          "$ref": "#/definitions/JobStageRuntimeView"
        },
        "translation": {
          "$ref": "#/definitions/JobStageRuntimeView"
        },
        "render": {
          "$ref": "#/definitions/JobStageRuntimeView"
        }
      }
    },
    "JobTimestampsView": {
      "type": "object",
      "required": [
        "created_at",
        "updated_at"
      ],
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "finished_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "duration_seconds": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "InvocationSummaryView": {
      "type": "object",
      "required": [
        "stage",
        "input_protocol",
        "stage_spec_schema_version"
      ],
      "properties": {
        "stage": {
          "type": "string"
        },
        "input_protocol": {
          "type": "string"
        },
        "stage_spec_schema_version": {
          "type": "string"
        }
      }
    },
    "JobListInvocationSummaryView": {
      "type": "object",
      "required": [
        "stage_spec_count",
        "unknown_count"
      ],
      "properties": {
        "stage_spec_count": {
          "type": "integer"
        },
        "unknown_count": {
          "type": "integer"
        }
      }
    },
    "LibraryDeleteResultView": {
      "type": "object",
      "required": [
        "deleted",
        "job_id",
        "removed_paths",
        "removed_child_jobs"
      ],
      "properties": {
        "deleted": {
          "type": "boolean"
        },
        "job_id": {
          "type": "string"
        },
        "removed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "removed_child_jobs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "LibraryDeleteQuery": {
      "type": "object",
      "properties": {
        "force": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "ListJobsQuery": {
      "type": "object",
      "properties": {
        "include_live_stage": {
          "type": "boolean",
          "description": "false 只读库里的任务摘要，不导入事件历史（首屏更快）；省略或 true 是完整的实时阶段。"
        },
        "limit": {
          "type": "integer"
        },
        "offset": {
          "type": "integer"
        },
        "status": {
          "$ref": "#/definitions/JobStatusKind"
        },
        "workflow": {
          "$ref": "#/definitions/WorkflowKind"
        },
        "provider": {
          "type": "string"
        },
        "q": {
          "type": "string"
        },
        "job_ids": {
          "type": "string"
        }
      }
    }
  }
}
