          "type": [
            "integer",
            "null"
          ],
          "description": "JobProgress.current，null=未知"
        },
        "total": {
          "type": [
            "integer",
            "null"
          ]
        },
        "percent": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "description": "page|batch|block|step|percent，skip_serializing_if None"
        }
      }
