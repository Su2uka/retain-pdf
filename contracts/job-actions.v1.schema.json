        },
        "end_page": {
          "type": [
            "integer",
            "null"
          ]
        },
        "max_items": {
          "type": [
            "integer",
            "null"
          ],
          "description": "最多审多少块（0 = 不限）；省略 = 不限"
        },
        "max_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "description": "最多用多少 token（0 = 不限）；省略 = 不限"
        }
      }
    },
    "ResumeJobInput": {
      "type": "object",
      "description": "routes/jobs/actions.rs :: RerunRequest（deny_unknown_fields）。POST actions/resume 的请求体，可以不带（空请求体等于 {}）。",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "overrides": {
          "anyOf": [
            {
              "$ref": "#/definitions/ResumeOverrides"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ResumeOverrides": {
      "type": "object",
      "description": "续跑只接受换模型 key：只有 translation 一段，别的段 400。",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "translation": {
          "$ref": "#/definitions/ResumeTranslationOverrides"
        }
      }
    },
    "ResumeTranslationOverrides": {
      "type": "object",
      "description": "换过的模型 key：续跑出新任务时替换原任务的旧凭据，明文 key 照建任务的规则导入凭据库。api_key 和 credential_ref 不能都非空，reviewer_api_key 和 reviewer_credential_ref 也一样（400）；别的字段 400。",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "api_key": {
          "type": "string"
        },
        "credential_ref": {
          "type": "string"
        },
        "reviewer_api_key": {
          "type": "string"
        },
        "reviewer_credential_ref": {
          "type": "string"
        }
      }
    },
    "RetryStageKind": {
      "type": "string",
      "enum": [
        "ocr",
        "translation",
        "render",
        "refine"
      ],
      "description": "job_types.rs :: RetryStageKind。refine = 在已有译文上挑错 + 定点修改，然后原地重渲染一次（不新建任务、不重翻）。"
    },
    "RetryStageOverrides": {
      "type": "object",
      "description": "stage_retry_overrides.rs。只写要改的字段，按段合并进原任务的设置；段名只能是这四个（别的 400），每段的字段同 create-job.v1 的 OcrInput / TranslationInput / RenderInput / RuntimeInput（不认识的字段 400）。runtime.job_id 会被清掉。",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "ocr": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/JsonValue"
          },
          "description": "字段同 create-job.v1 的 OcrInput"
        },
        "translation": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/JsonValue"
          },
          "description": "字段同 create-job.v1 的 TranslationInput"
        },
        "render": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/JsonValue"
          },
          "description": "字段同 create-job.v1 的 RenderInput；render.engine 不合法 400"
        },
        "runtime": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/JsonValue"
          },
          "description": "字段同 create-job.v1 的 RuntimeInput"
        }
      }
    },
    "RetryStageRequest": {
      "type": "object",
      "description": "job_types.rs :: RetryStageRequest（deny_unknown_fields，不认识的字段 400）。POST actions/retry-stage 的请求体。ambiguous_request_policy 省略等于 block。",
      "additionalProperties": false,
      "required": [
        "stage"
      ],
      "properties": {
        "stage": {
          "$ref": "#/definitions/RetryStageKind"
        },
        "mode": {
          "type": "string",
          "enum": [
            "from_stage"
          ],
          "description": "省略等于 from_stage，目前只支持它（空串也按 from_stage）"
        },
        "create_new_job": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "省略或 null 时按 stage 取默认：refine → false（只支持原地），其余 → true。只有 render、refine 能 false。"
        },
        "overrides": {
          "anyOf": [
            {
              "$ref": "#/definitions/RetryStageOverrides"
            },
            {
              "type": "null"
            }
          ]
        },
        "ambiguous_request_policy": {
          "$ref": "#/definitions/AmbiguousRequestPolicy"
        },
        "refine": {
          "anyOf": [
            {
              "$ref": "#/definitions/RefineRetryRequest"
            },
            {
              "type": "null"
            }
          ],
          "description": "只对 stage=refine 有意义，省略 = 全书 review_and_fix；带在别的 stage 上 400"
        }
      }
    },
    "RetryStageSubmissionView": {
      "type": "object",
      "description": "job_types.rs :: RetryStageSubmissionView。retry-stage 的返回，也是 resolve-ocr-ambiguity 返回里的 submission。刚提交，status 总是 queued。",
      "additionalProperties": false,
      "required": [
        "job_id",
        "source_job_id",
        "status",
        "workflow",
        "rerun_from_stage",
        "reused_artifacts",
