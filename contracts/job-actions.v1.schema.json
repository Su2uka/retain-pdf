            "type": "string"
          }
        },
        "reruns_stages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "不能续跑的文字说明"
        },
        "reason_code": {
          "anyOf": [
