    "JobResumePlanView": {
      "type": "object",
      "description": "job_types.rs :: JobResumePlanView。GET actions/resume 的返回。",
      "additionalProperties": false,
      "required": [
        "can_resume",
        "job_id",
        "from_stage",
        "resume_workflow",
