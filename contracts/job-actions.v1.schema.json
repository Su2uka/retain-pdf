        },
        "artifacts_url": {
          "type": "string"
        },
        "artifacts_manifest_path": {
          "type": "string"
        },
        "artifacts_manifest_url": {
          "type": "string"
        },
        "events_path": {
          "type": "string"
        },
        "events_url": {
          "type": "string"
        },
        "cancel_path": {
          "type": "string"
        },
        "cancel_url": {
          "type": "string"
        }
      }
    },
    "JobProgressView": {
      "type": "object",
