        "ambiguous_request_policy",
        "links",
        "actions"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "description": "开跑的任务：新建任务时是新编号，原地执行时就是 source_job_id"
        },
        "source_job_id": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/JobStatusKind"
        },
        "workflow": {
          "$ref": "#/definitions/WorkflowKind"
        },
        "rerun_from_stage": {
          "$ref": "#/definitions/RetryStageKind"
        },
        "reused_artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rerun_stages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ambiguous_request_policy": {
          "$ref": "#/definitions/AmbiguousRequestPolicy"
        },
        "links": {
          "$ref": "#/definitions/JobLinksView"
        },
        "actions": {
          "$ref": "#/definitions/JobActionsView"
        }
      }
    },
    "StageActionsView": {
      "type": "object",
      "description": "job_types.rs :: StageActionsView。GET actions 的返回。",
      "additionalProperties": false,
      "required": [
        "job_id",
        "stages"
      ],
      "properties": {
        "job_id": {
          "type": "string"
        },
        "stages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/StageRetryActionView"
          }
        }
      }
    },
    "StageRetryActionLinkView": {
      "type": "object",
      "description": "job_types.rs :: StageRetryActionLinkView。body 是能直接发出去的请求体：普通阶段是 {stage, ambiguous_request_policy: block}；refine 是 {stage: refine, create_new_job: false, ambiguous_request_policy: block, refine: {mode: review_and_fix}}。",
      "additionalProperties": false,
      "required": [
        "method",
        "url",
        "body"
      ],
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "POST"
          ],
          "description": "目前总是 POST"
        },
        "url": {
          "type": "string",
          "description": "retry-stage 的完整地址"
        },
        "body": {
          "$ref": "#/definitions/RetryStageRequest"
        }
      }
    },
    "StageRetryActionView": {
      "type": "object",
      "description": "job_types.rs :: StageRetryActionView。一个阶段能不能重试。last_refine 只在 refine 这一项上、而且精修过才有，其余时候整个键不出现。",
      "additionalProperties": false,
      "required": [
        "stage",
        "label",
        "can_retry",
        "reason",
        "disabled_reason",
        "disabled_code",
        "action",
        "will_reuse",
        "will_rerun",
        "danger"
      ],
      "properties": {
        "stage": {
          "$ref": "#/definitions/RetryStageKind"
        },
        "label": {
          "type": "string",
          "description": "界面上的名字（中文）"
        },
        "can_retry": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "description": "同 disabled_reason（旧名，保留）"
        },
        "disabled_reason": {
          "type": "string",
          "description": "不能重试的文字说明；能重试时是空串"
        },
        "disabled_code": {
          "anyOf": [
            {
              "$ref": "#/definitions/ActionBlockReason"
            },
            {
              "type": "null"
            }
          ],
          "description": "disabled_reason 的机器可读版本；disabled_reason 为空时为 null。翻译阶段在请求结果拿不准时 can_retry 仍为 true，这里是 ambiguous_translation_request（重试要带 ambiguous_request_policy=accept_duplicate_risk）。"
        },
        "action": {
          "anyOf": [
            {
              "$ref": "#/definitions/StageRetryActionLinkView"
            },
            {
              "type": "null"
            }
          ],
          "description": "能重试时给出请求怎么写；不能时为 null"
        },
        "will_reuse": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "会复用的产物"
        },
        "will_rerun": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "会重跑的阶段"
        },
        "danger": {
          "type": "boolean"
        },
        "last_refine": {
          "$ref": "#/definitions/LastRefineView"
        }
      }
    },
    "WorkflowKind": {
      "type": "string",
      "enum": [
        "book",
        "ocr",
        "translate",
        "render"
      ]
    }
