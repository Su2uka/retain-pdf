        "confidence",
        "evidence"
      ],
      "properties": {
        "value": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "description": "候选从哪来，例如 pdf_metadata、ocr_structure。"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DocumentMetadataEvidenceView"
          }
        }
      }
    },
    "DocumentMetadataSuggestionView": {
      "type": "object",
      "description": "views.rs :: DocumentMetadataSuggestionView。只有 source_job_id 在没有时整个键不出现（不是 null）。",
      "required": [
        "suggestion_id",
        "document_id",
        "artifact_sha256",
        "status",
        "fields",
        "title_candidates",
        "selected_title",
        "generation_method",
        "needs_ai_review",
        "applied",
        "can_apply",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "suggestion_id": {
          "type": "string"
        },
        "document_id": {
          "type": "string"
        },
        "source_job_id": {
          "type": "string",
          "description": "从哪个任务的规范化 OCR 产物读出来的；只读了原文 PDF 时键不出现。"
        },
        "artifact_sha256": {
          "type": "string",
          "description": "读的那份产物（或原文）的 sha256。"
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "applied"
          ]
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "v1 只有 title。"
        },
        "title_candidates": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DocumentTitleCandidateView"
          }
        },
        "selected_title": {
          "type": "string"
        },
        "generation_method": {
          "type": "string",
          "description": "等于被选中那个候选的 source（pdf_metadata 或 ocr_structure）。"
        },
        "needs_ai_review": {
          "type": "boolean"
        },
        "applied": {
          "type": "boolean",
          "description": "已采用，而且书名现在还是它（用户之后改过就是 false）。"
        },
        "can_apply": {
          "type": "boolean",
          "description": "现在还能采用：已采用，或者书名仍是默认值（title_source=filename 且没锁）。"
        },
        "created_at": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        }
      }
    },
