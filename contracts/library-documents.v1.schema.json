        },
        "page_idx": {
          "type": "integer",
          "minimum": 0,
          "description": "0 起的页号；没有时键不出现。"
        },
        "block_id": {
          "type": "string",
          "description": "没有时键不出现。"
        },
        "structure_role": {
          "type": "string",
          "description": "没有时键不出现。"
        },
        "layout_role": {
          "type": "string",
          "description": "没有时键不出现。"
        }
      }
    },
    "DocumentTitleCandidateView": {
      "type": "object",
      "description": "views.rs :: DocumentTitleCandidateView。",
