        "stage_spec_count": {
          "type": "integer"
        },
        "unknown_count": {
          "type": "integer"
        }
      }
    },
    "LibraryDeleteResultView": {
      "type": "object",
      "required": [
        "deleted",
        "job_id",
        "removed_paths",
        "removed_child_jobs"
      ],
      "properties": {
        "deleted": {
          "type": "boolean"
        },
        "job_id": {
          "type": "string"
        },
        "removed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "removed_child_jobs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "LibraryBatchDeleteResultView": {
      "type": "object",
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LibraryDeleteResultView"
          }
        }
      }
    },
    "LibraryDeleteQuery": {
      "type": "object",
      "properties": {
        "force": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "LibraryBatchDeleteInput": {
      "type": "object",
      "required": [
        "ids"
      ],
      "properties": {
        "ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "force": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "ListLibraryBooksQuery": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "default": 40
        },
        "offset": {
          "type": "integer",
          "default": 0
        },
        "q": {
          "type": "string"
        },
        "job_ids": {
          "type": "string",
          "description": "逗号分隔 job_id 白名单，对应 ListJobsQuery.job_ids"
        }
      }
    },
    "ListJobsQuery": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer"
        },
        "offset": {
          "type": "integer"
        },
        "status": {
          "$ref": "#/definitions/JobStatusKind"
        },
        "workflow": {
          "$ref": "#/definitions/WorkflowKind"
        },
        "provider": {
          "type": "string"
        },
        "q": {
          "type": "string"
        },
        "job_ids": {
          "type": "string"
        }
      }
    }
  }
}
