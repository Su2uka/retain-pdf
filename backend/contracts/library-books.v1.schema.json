{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "retainpdf/contracts/library-books/v1",
  "title": "图书馆书架契约（Library Books）",
  "description": "Rust ↔ TS 重复的图书馆视图单一真值。生产者：backend/packages/retainpdf-library/src/views.rs（LibraryBookListView / LibraryBookListItemView）与 backend/packages/retainpdf-jobs/src/views/job_types.rs（JobListView / JobListItemView / JobFailureBriefView）、views/common.rs（JobDeleteResultView，书架删除的 LibraryDeleteResultView 是它的别名）；消费者：@retainpdf/contracts/library-books 生成 DTO、packages/domain 的 job 归一化模型、apps/web 的 library API 与 apps/web-react 的 library 类型层。所有响应为 {code, message, data} 信封，本契约描述 data 部分。改契约先改本文件，再重新生成 DTO 并让 Rust 与 TS 契约测试变绿。",
  "base_path": "/api/v1/library",
  "endpoints": [
    {
      "method": "GET",
      "path": "/api/v1/library/books",
      "query": "ListLibraryBooksQuery",
      "output": "LibraryBookListView",
      "rust_view": "LibraryBookListView",
      "ts_consumer": "@retainpdf/contracts/library-books :: LibraryBookListView",
      "note": "冻结（2026-10-19）：不再加字段。前端改调 GET /api/v1/jobs?job_ids=&limit=&include_live_stage=true 以后删。"
    },
    {
      "method": "GET",
      "path": "/api/v1/library/books/:job_id",
      "output": "LibraryBookDetailView",
      "ts_consumer": "@retainpdf/contracts/library-books :: LibraryBookDetailView",
      "removed": "2026-10-19",
      "note": "接口已删（没有调用方），Rust 不再产出这个类型、请求得 405。条目只为让生成的 TS 类型 LibraryBookDetailView 暂时还在：前端 frontend/packages/api/src/types.ts 和 frontend/web/tests/contracts/library-books-contract.test.mjs 还引用它。前端去掉引用后，删这个条目和 LibraryBookDetailView 定义。"
    },
    {
      "method": "GET",
      "path": "/api/v1/jobs",
      "query": "ListJobsQuery",
      "output": "JobListView",
      "rust_view": "JobListView",
      "ts_consumer": "@retainpdf/contracts/library-books :: JobListView"
    },
    {
      "method": "DELETE",
      "path": "/api/v1/jobs/:job_id",
      "query": "LibraryDeleteQuery",
      "output": "LibraryDeleteResultView",
      "rust_view": "JobDeleteResultView",
      "note": "删一个任务和它的 -ocr 子任务，书留着；OCR 任务也能删。查询参数在 Rust 里是 DeleteJobQuery，和 LibraryDeleteQuery 同形。"
    },
    {
      "method": "DELETE",
      "path": "/api/v1/library/books/:job_id",
      "query": "LibraryDeleteQuery",
      "output": "LibraryDeleteResultView",
      "note": "旧地址，新地址 DELETE /api/v1/jobs/:job_id；行为不变（OCR 任务 404）。"
    },
    {
      "method": "POST",
      "path": "/api/v1/library/books/batch-delete",
      "input": "LibraryBatchDeleteInput",
      "output": "LibraryBatchDeleteResultView"
    }
  ],
  "definitions": {
    "JobStatusKind": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "canceled"
      ],
      "description": "crate::models::common::JobStatusKind (serde rename_all snake_case)"
    },
    "WorkflowKind": {
      "type": "string",
      "enum": [
        "book",
        "ocr",
        "translate",
        "render"
      ],
      "description": "crate::models::common::WorkflowKind"
    },
    "JobProgressView": {
      "type": "object",
      "description": "backend/packages/retainpdf-jobs/src/views/common.rs :: JobProgressView。current/total 为页/批计数（i64），percent 0-100，unit 标识页/批/步/percent。",
      "required": [],
      "properties": {
        "current": {
          "type": [
            "integer",
            "null"
          ],
          "description": "已完成计数，null=未知"
        },
        "total": {
          "type": [
            "integer",
            "null"
          ],
          "description": "总数，null=未定/不定长"
        },
        "percent": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "description": "page|batch|step|percent|null，skip_serializing_if None"
        }
      }
    },
    "ArtifactDisplayItemView": {
      "type": "object",
      "required": [
        "key",
        "label",
        "ready",
        "kind"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "ready": {
          "type": "boolean"
        },
        "kind": {
          "type": "string"
        },
        "file_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "download_url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "LibraryBookListItemView": {
      "type": "object",
      "description": "job_types.rs :: LibraryBookListItemView — 书架卡片。job_id 是主键（كر очередь: id 冗余为 job_id 别名），display_name 回退为 title/source_file_name。",
      "required": [
        "id",
        "job_id",
        "title",
        "display_name",
        "status",
        "progress",
        "output_pdf_ready",
        "markdown_ready",
        "bundle_ready",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "book id (= job_id 去 ocr 后缀的归一化)"
        },
        "job_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "source_file_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "authors": {
          "type": [
            "string",
            "null"
          ]
        },
        "page_count": {
          "type": [
            "integer",
            "null"
          ]
        },
        "status": {
          "$ref": "#/definitions/JobStatusKind"
        },
        "stage": {
          "type": [
            "string",
            "null"
          ],
          "description": "当前阶段 raw stage，null=未开始"
        },
        "stage_detail": {
          "type": [
            "string",
            "null"
          ]
        },
        "progress": {
          "$ref": "#/definitions/JobProgressView"
        },
        "cover_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "thumbnail_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "output_pdf_ready": {
          "type": "boolean"
        },
        "markdown_ready": {
          "type": "boolean"
        },
        "bundle_ready": {
          "type": "boolean"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "LibraryBookListView": {
      "type": "object",
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LibraryBookListItemView"
          }
        }
      }
    },
    "LibraryBookDetailView": {
      "description": "已废弃：GET /api/v1/library/books/:job_id 2026-10-19 删了，Rust 侧不再产出。前端去掉引用后删除本定义（见 endpoints 里那条 removed 的说明）。",
      "type": "object",
      "required": [
        "id",
        "job_id",
        "title",
        "status",
        "progress",
        "cover_url",
        "thumbnail_url",
        "artifacts"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "job_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "authors": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_file_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "page_count": {
          "type": [
            "integer",
            "null"
          ]
        },
        "source_language": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_language": {
          "type": [
            "string",
            "null"
          ]
        },
        "file_size_bytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "status": {
          "$ref": "#/definitions/JobStatusKind"
        },
        "stage": {
          "type": [
            "string",
            "null"
          ]
        },
        "progress": {
          "$ref": "#/definitions/JobProgressView"
        },
        "cover_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "thumbnail_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ArtifactDisplayItemView"
          }
        }
      }
    },
    "JobFailureBriefView": {
      "type": "object",
      "description": "backend/packages/retainpdf-jobs/src/views/job_types.rs :: JobFailureBriefView — 列表里那份精简失败信息。只有失败的任务才带（JobListItemView.failure），成功 / 进行中的任务整个键不出现，不是 null。只放「一眼能判断该怎么办」的几项，不带 raw_excerpt / traceback；要完整错误按需去打任务详情（那边的 failure 是 JobFailureInfo）。root_cause / suggestion / provider 为空时整个键不出现（不是 null）。",
      "required": [
        "category",
        "stage",
        "retryable",
        "summary"
      ],
      "properties": {
        "category": {
          "type": "string",
          "description": "面向用户的分类：provider / translation / timeout / render / internal …"
        },
        "stage": {
          "type": "string",
          "description": "失败发生在哪一段：ocr / translation / render"
        },
        "retryable": {
          "type": "boolean",
          "description": "能不能重试。"
        },
        "summary": {
          "type": "string",
          "description": "一句话结论。"
        },
        "root_cause": {
          "type": "string",
          "description": "根因；没有时键不出现。"
        },
        "suggestion": {
          "type": "string",
          "description": "建议的处理办法；没有时键不出现。"
        },
        "provider": {
          "type": "string",
          "description": "上游是谁（mineru / deepseek …），排查时第一眼要看的；没有时键不出现。"
        }
      }
    },
    "JobListItemView": {
      "type": "object",
      "description": "job_types.rs :: JobListItemView — /api/v1/jobs 列表项，含 stage_snapshot 与 cover/thumbnail 双图。",
      "required": [
        "job_id",
        "display_name",
        "workflow",
        "status",
        "attempt",
        "retry_count",
        "last_retry_at",
        "stage_snapshot",
        "background_snapshots",
        "stages",
        "output_pdf_ready",
        "markdown_ready",
        "bundle_ready",
        "created_at",
        "updated_at",
        "detail_path",
        "detail_url"
      ],
      "properties": {
        "job_id": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "workflow": {
          "$ref": "#/definitions/WorkflowKind"
        },
        "status": {
          "$ref": "#/definitions/JobStatusKind"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "retry_count": {
          "type": "integer",
          "minimum": 0
        },
        "last_retry_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "trace_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "completion_note": {
          "type": [
            "string",
            "null"
          ],
          "description": "终态任务的完成说明，仅在有额外信息时出现（正常完成为 null）。例如「任务完成，但有 N 个内容块保留原文未翻译」。这不是阶段字段——终态的 stage_snapshot 恒为 null。"
        },
        "stage_snapshot": {
          "anyOf": [
            {
              "$ref": "#/definitions/JobStageSnapshotView"
            },
            {
              "type": "null"
            }
          ]
        },
        "background_snapshots": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/JobStageSnapshotView"
          }
        },
        "stages": {
          "$ref": "#/definitions/JobStagesView"
        },
        "page_count": {
          "type": [
            "integer",
            "null"
          ]
        },
        "source_file_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "cover_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "thumbnail_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "output_pdf_ready": {
          "type": "boolean"
        },
        "markdown_ready": {
          "type": "boolean"
        },
        "bundle_ready": {
          "type": "boolean"
        },
        "invocation": {
          "anyOf": [
            {
              "$ref": "#/definitions/InvocationSummaryView"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "detail_path": {
          "type": "string"
        },
        "detail_url": {
          "type": "string"
        },
        "source_artifact_job_id": {
          "type": ["string", "null"],
          "description": "复用了哪个任务的产物（OCR / 译文）；顺着它能找到真正持有译文的任务。没有复用时为 null。"
        },
        "failure": {
          "$ref": "#/definitions/JobFailureBriefView"
        }
      }
    },
    "JobListView": {
      "type": "object",
      "required": [
        "items",
        "invocation_summary",
        "limit",
        "offset",
        "has_more"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/JobListItemView"
          }
        },
        "invocation_summary": {
          "$ref": "#/definitions/JobListInvocationSummaryView"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "description": "实际生效的条数上限。越界（0 或大于 500）是 400，不会被夹，所以总等于请求的值；没传是 20。"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "has_more": {
          "type": "boolean",
          "description": "这一页之后还有没有。"
        }
      }
    },
    "JobStageSnapshotView": {
      "type": "object",
      "description": "job_types.rs :: JobStageSnapshotView — 阶段快照（含 display_stage / stage / substage / lane / stage_detail / progress）。前端 normalize 与阶段进度均以此驱动。",
      "required": [
        "progress"
      ],
      "properties": {
        "display_stage": {
          "type": [
            "string",
            "null"
          ]
        },
        "stage": {
          "type": [
            "string",
            "null"
          ]
        },
        "substage": {
          "type": [
            "string",
            "null"
          ]
        },
        "lane": {
          "type": [
            "string",
            "null"
          ],
          "description": "main|background"
        },
        "stage_detail": {
          "type": [
            "string",
            "null"
          ]
        },
        "progress": {
          "$ref": "#/definitions/JobProgressView"
        }
      }
    },
    "JobStageStateView": {
      "type": "string",
      "enum": [
        "reused",
        "queued",
        "pending",
        "in_progress",
        "completed",
        "failed",
        "skipped"
      ]
    },
    "JobStageRuntimeView": {
      "type": "object",
      "required": [
        "state",
        "progress"
      ],
      "properties": {
