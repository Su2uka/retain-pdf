          "$ref": "#/definitions/JobStageRuntimeView"
        },
        "translation": {
          "$ref": "#/definitions/JobStageRuntimeView"
        },
        "render": {
          "$ref": "#/definitions/JobStageRuntimeView"
        }
      }
    },
    "JobTimestampsView": {
      "type": "object",
      "required": [
        "created_at",
        "updated_at"
      ],
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "finished_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "duration_seconds": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "InvocationSummaryView": {
      "type": "object",
      "required": [
        "stage",
        "input_protocol",
        "stage_spec_schema_version"
      ],
      "properties": {
        "stage": {
          "type": "string"
        },
        "input_protocol": {
          "type": "string"
        },
        "stage_spec_schema_version": {
          "type": "string"
        }
      }
    },
    "JobListInvocationSummaryView": {
